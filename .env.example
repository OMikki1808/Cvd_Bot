# =============================================================================
# Cvd_Bot — PAPER runtime of the real CVD strategy (082F Engine-v2, limit 1-bar)
# Source of truth: OMikki1808/CVDBot-prodaction (see docs/STRATEGY_SOURCE.md).
# LIVE is not implemented. Never commit real keys.
# =============================================================================

TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
LOG_LEVEL=info

# Signals: Binance SPOT 15m klines, aggregated to 1H inside the engine (public, no keys).
BINANCE_SPOT_REST_URL=https://data-api.binance.vision
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443
WS_INBOUND_TIMEOUT_SEC=90
HTTP_TIMEOUT_MS=15000
# History replayed silently on first start (no state in DB yet).
WARMUP_DAYS=7

# Frozen pool with per-symbol RR (PHASE50_TOP35_2026_09 | PHASE56_BINANCE_MARGIN_TEST15_2026_09).
POOL_VERSION=PHASE50_TOP35_2026_09
# Optional subset of the pool, e.g. SYMBOLS=DOGEUSDT,SOLUSDT,BTCUSDT
SYMBOLS=
RISK_PERCENT=1
# Python fill quirks (limit1bar). true = realistic (default), false = identical to the Python engine.
# Check SL/TP on the 1H bar right after an immediate fill:
CHECK_EXITS_AFTER_IMMEDIATE_FILL=true
# An already-marketable limit fills at the current price, not at the (worse) limit price:
IMMEDIATE_FILL_AT_MARKET=true
# limit1bar = production (V082F_ENGINE_V2_LIMIT_1BAR), market = V082F_ENGINE_V2 (market entry)
STRATEGY_MODE=limit1bar
# Uniform RR for every symbol (0 = per-symbol RR from the pool)
RR_ALL=0
# Trend filter: long only if the 1H close is above the close N hours ago, short only if below (0 = off)
TREND_FILTER_HOURS=0
# Skip setups whose stop is closer than this % of entry (0 = off)
MIN_STOP_PCT=0

# Shared paper account.
PAPER_STARTING_EQUITY=10000
# Costs (Python runtime ignores them; set both to 0 to reproduce its numbers).
# Binance VIP0: spot/margin 10/10, USD-M futures taker 5 / maker 2
TAKER_FEE_BPS=10
MAKER_FEE_BPS=10
SLIPPAGE_BPS=5
# Exposure limits (0 = off). Python: 15 positions, no leverage limit.
MAX_ACTIVE_POSITIONS=15
MAX_POSITION_LEVERAGE=5
MAX_TOTAL_LEVERAGE=0
# cap = shrink qty to fit, reject = skip the entry
LEVERAGE_MODE=cap

DATABASE_PATH=./data/cvd-bot.sqlite

# Telegram (optional — leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
