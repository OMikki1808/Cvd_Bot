# =============================================================================
# Cvd_Bot / BINSC-style engine
# PAPER is the default. LIVE stays off until the Before LIVE checklist is done.
# Never commit real API keys.
# =============================================================================

# PAPER | LIVE
TRADING_MODE=PAPER

# Extra hard gate. Must be true AND TRADING_MODE=LIVE to send real orders.
LIVE_TRADING_ENABLED=false

LOG_LEVEL=info

# Binance USD-M futures (public market data does not need keys)
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Comma-separated USD-M symbols. Source-of-truth watchlist for this bot.
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,SUIUSDT
TIMEFRAME=5m

# Paper account
PAPER_STARTING_BALANCE_USDT=10000

# Database (SQLite)
DATABASE_PATH=./data/cvd-bot.sqlite

# Telegram (optional — leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CVD strategy (defaults match the implemented engine) ---
CVD_PIVOT_LEFT=5
CVD_PIVOT_RIGHT=5
CVD_DIV_RANGE_LOWER=5
CVD_DIV_RANGE_UPPER=60
CVD_CONFIRMATION_WINDOW=8
CVD_ATR_PERIOD=14
CVD_DELTA_SMA_PERIOD=20
CVD_VOLUME_SMA_PERIOD=20
CVD_ABSORPTION_DELTA_MULT=1.5
CVD_ABSORPTION_VOLUME_MULT=1.2
CVD_ABSORPTION_RANGE_ATR_MULT=0.7
CVD_ABSORPTION_CLOSE_LOCATION=0.55
CVD_WARMUP_BARS=200
CVD_SL_BUFFER_TICKS=1

# Risk: percent of current equity per trade
RISK_PERCENT=0.5
DEFAULT_RR=2
# Symbol-specific RR overrides, format: BTCUSDT:2,ETHUSDT:2,SOLUSDT:1.8
SYMBOL_RR=BTCUSDT:2,ETHUSDT:2,BNBUSDT:2,SOLUSDT:1.8,XRPUSDT:1.8,DOGEUSDT:1.8,ADAUSDT:1.8,AVAXUSDT:1.8,LINKUSDT:1.8,SUIUSDT:1.8
