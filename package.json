{
  "name": "cvd-bot",
  "version": "1.0.0",
  "private": true,
  "description": "PAPER runtime + backtester for the real CVD divergence strategy (082F Engine-v2, limit 1-bar)",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest": "tsx src/backtest/cli.ts",
    "fetch-data": "tsx src/backtest/fetchKlines.ts",
    "parity": "tsx tests/parity/runParity.ts",
    "parity:oracle": "python3 parity/run_oracle.py > tests/fixtures/parity082f.json"
  },
  "dependencies": {
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
